<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.module.category" id="module_category_cashflow">
        <field name="name">Cash Flow Forecast</field>
        <field name="sequence">30</field>
        <field name="parent_id" ref="base.module_category_accounting"/>
    </record>

    <!-- Users read accounting data (journal items, balances): they get the read-only
         accounting group, which grants read access and nothing more. -->
    <record id="group_cashflow_user" model="res.groups">
        <field name="name">User</field>
        <field name="category_id" ref="module_category_cashflow"/>
        <field name="implied_ids" eval="[(4, ref('base.group_user')), (4, ref('account.group_account_readonly'))]"/>
        <field name="comment">View the cash position and saved forecasts, generate forecasts. Includes read-only accounting access: read access to every journal entry of the user's companies.</field>
    </record>

    <record id="group_cashflow_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="category_id" ref="module_category_cashflow"/>
        <field name="implied_ids" eval="[(4, ref('group_cashflow_user'))]"/>
        <field name="comment">Also edit the minimum cash threshold and delete forecasts.</field>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <data noupdate="1">
        <record id="rule_forecast_company" model="ir.rule">
            <field name="name">Cash flow forecast: multi-company</field>
            <field name="model_id" ref="model_elaf_cashflow_forecast"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_forecast_line_company" model="ir.rule">
            <field name="name">Cash flow forecast bucket: multi-company</field>
            <field name="model_id" ref="model_elaf_cashflow_forecast_line"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_forecast_day_company" model="ir.rule">
            <field name="name">Cash flow forecast day: multi-company</field>
            <field name="model_id" ref="model_elaf_cashflow_forecast_day"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
        <record id="rule_forecast_flow_company" model="ir.rule">
            <field name="name">Cash flow forecast flow: multi-company</field>
            <field name="model_id" ref="model_elaf_cashflow_forecast_flow"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        </record>
    </data>
</odoo>
