<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Dedicated, non-default list of journal items used by Cash Flow drill-downs. -->
    <record id="elaf_cf_move_line_list" model="ir.ui.view">
        <field name="name">account.move.line.list.elaf.cashflow</field>
        <field name="model">account.move.line</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-danger="date_maturity and date_maturity &lt; current_date and not reconciled">
                <field name="date"/>
                <field name="move_id"/>
                <field name="journal_id"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="name" optional="show"/>
                <field name="date_maturity"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="balance" sum="Total" string="Amount (company currency)"/>
                <field name="amount_residual" sum="Total residual" string="Open residual"/>
                <field name="amount_residual_currency" string="Open residual (document currency)" optional="show"/>
                <field name="reconciled" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>
</odoo>
