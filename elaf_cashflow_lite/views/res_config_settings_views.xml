<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_elaf_cashflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.elaf.cashflow</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="60"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Cash Flow" string="Cash Flow" name="elaf_cashflow_lite"
                     groups="elaf_cashflow_lite.group_cashflow_manager">
                    <block title="Forecast" name="elaf_cf_forecast_settings">
                        <setting id="elaf_cf_min_cash" company_dependent="1"
                                 help="Projected balances below this amount are flagged as a liquidity shortage.">
                            <field name="elaf_cf_min_cash"/>
                        </setting>
                        <setting id="elaf_cf_include_outstanding" company_dependent="1"
                                 help="Add outstanding receipts and subtract outstanding payments in the opening balance.">
                            <field name="elaf_cf_include_outstanding"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
