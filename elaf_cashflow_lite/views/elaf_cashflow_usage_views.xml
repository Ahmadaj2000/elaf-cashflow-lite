<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elaf_cf_usage_list" model="ir.ui.view">
        <field name="name">elaf.cashflow.usage.list</field>
        <field name="model">elaf.cashflow.usage</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="key"/>
                <field name="used"/>
                <field name="usage_limit"/>
                <field name="bound_company_id"/>
                <field name="last_used_at"/>
            </tree>
        </field>
    </record>

    <record id="elaf_cf_usage_log_list" model="ir.ui.view">
        <field name="name">elaf.cashflow.usage.log.list</field>
        <field name="model">elaf.cashflow.usage.log</field>
        <field name="arch" type="xml">
            <tree create="0" edit="0" delete="0">
                <field name="at"/>
                <field name="event"/>
                <field name="user_id"/>
                <field name="res_ref"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <record id="action_usage" model="ir.actions.act_window">
        <field name="name">Lite Usage</field>
        <field name="res_model">elaf.cashflow.usage</field>
        <field name="view_mode">list</field>
    </record>

    <record id="action_usage_log" model="ir.actions.act_window">
        <field name="name">Lite Usage Log</field>
        <field name="res_model">elaf.cashflow.usage.log</field>
        <field name="view_mode">list</field>
    </record>
</odoo>
