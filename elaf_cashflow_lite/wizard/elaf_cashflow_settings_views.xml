<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="elaf_cf_settings_form" model="ir.ui.view">
        <field name="name">elaf.cashflow.settings.form</field>
        <field name="model">elaf.cashflow.settings</field>
        <field name="arch" type="xml">
            <form string="Cash Flow Settings">
                <sheet>
                    <group>
                        <group>
                            <field name="company_id"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="min_cash"/>
                            <field name="include_outstanding"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        Changes apply to the next forecast. Saved forecasts keep the threshold used at the time
                        they were calculated.
                    </p>
                </sheet>
                <footer>
                    <button name="action_save" type="object" string="Save" class="btn-primary"/>
                    <button special="cancel" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_settings" model="ir.actions.act_window">
        <field name="name">Cash Flow Settings</field>
        <field name="res_model">elaf.cashflow.settings</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
